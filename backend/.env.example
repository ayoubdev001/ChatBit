# =========================
# Server
# =========================
PORT=3000
NODE_ENV=development

# =========================
# Database (PostgreSQL)
# =========================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=chatbit
DB_NAME_TEST=chatbit_test

# =========================
# JWT
# =========================
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# =========================
# CORS (mobile app origin, adjust as needed)
# =========================
CLIENT_URL=http://localhost:8081